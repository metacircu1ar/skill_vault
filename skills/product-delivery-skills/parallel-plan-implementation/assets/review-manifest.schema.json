{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/parallel-plan-implementation/review-manifest.schema.json",
  "title": "Parallel Phase Commit Review Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "repository_root",
    "parallel_root",
    "review_root",
    "authorization_record",
    "review_baseline_commit",
    "pre_phase_base_commit",
    "backup_ref",
    "rewrite_branch",
    "publication_status",
    "force_push_authorized",
    "history_strategy",
    "reviewer_profile",
    "review_execution",
    "phase_order",
    "phase_reviews",
    "finding_dispositions",
    "findings_summary",
    "validation_commands",
    "final_code_checkpoint",
    "metadata_commit",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "preparing",
        "reviewing",
        "findings-received",
        "verifying-findings",
        "rewriting",
        "validating",
        "blocked",
        "completed"
      ]
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "parallel_root": {
      "type": "string",
      "minLength": 1
    },
    "review_root": {
      "type": "string",
      "minLength": 1
    },
    "authorization_record": {
      "type": "string",
      "minLength": 1
    },
    "review_baseline_commit": {
      "$ref": "#/$defs/commit"
    },
    "pre_phase_base_commit": {
      "$ref": "#/$defs/commit"
    },
    "backup_ref": {
      "type": "string",
      "minLength": 1
    },
    "rewrite_branch": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "enum": [
        "unpublished",
        "published",
        "protected",
        "unknown"
      ]
    },
    "force_push_authorized": {
      "type": "boolean"
    },
    "history_strategy": {
      "enum": [
        "linear-phase-commits",
        "linearized-review-branch",
        "blocked"
      ]
    },
    "reviewer_profile": {
      "$ref": "#/$defs/reviewerProfile"
    },
    "phase_order": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phaseId"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "phase_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phaseReview"
      },
      "minItems": 1
    },
    "finding_dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disposition"
      }
    },
    "findings_summary": {
      "$ref": "#/$defs/summary"
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandResult"
      }
    },
    "final_code_checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/commit"
        },
        {
          "const": "pending"
        }
      ]
    },
    "metadata_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/commit"
        },
        {
          "const": "pending"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "review_execution": {
      "$ref": "#/$defs/reviewExecution"
    }
  },
  "$defs": {
    "phaseId": {
      "type": "string",
      "pattern": "^PH-[0-9]{3,}-[0-9]{2,}$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^CMP-[0-9]{3,}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$",
      "minLength": 7
    },
    "reviewerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_model",
        "requested_reasoning_effort",
        "actual_model",
        "actual_reasoning_effort",
        "selection_status",
        "substitution_approved"
      ],
      "properties": {
        "requested_model": {
          "const": "gpt-5.6-sol"
        },
        "requested_reasoning_effort": {
          "const": "xhigh"
        },
        "actual_model": {
          "type": "string",
          "minLength": 1
        },
        "actual_reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "selection_status": {
          "enum": [
            "confirmed",
            "host-unverifiable",
            "unavailable",
            "substituted"
          ]
        },
        "substitution_approved": {
          "type": "boolean"
        }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status",
        "summary"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "phase_ids"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "pattern": "^RB-[0-9]{3,}$"
        },
        "phase_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phaseId"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "reviewExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_parallel_reviewers",
        "batches"
      ],
      "properties": {
        "mode": {
          "enum": [
            "pending",
            "single-phase",
            "parallel",
            "bounded-parallel",
            "blocked"
          ]
        },
        "max_parallel_reviewers": {
          "type": "integer",
          "minimum": 0
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewBatch"
          }
        }
      }
    },
    "phaseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "component_id",
        "original_commit",
        "original_parent",
        "current_commit",
        "review_baseline_commit",
        "plan_path",
        "plan_section",
        "boundary_path",
        "boundary_section",
        "contract_ids",
        "external_fidelity_required",
        "prompt_path",
        "findings_path",
        "reviewer_instance_id",
        "status",
        "limitations",
        "review_batch_id",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "phase_id": {
          "$ref": "#/$defs/phaseId"
        },
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "original_commit": {
          "$ref": "#/$defs/commit"
        },
        "original_parent": {
          "$ref": "#/$defs/commit"
        },
        "current_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "const": "pending"
            }
          ]
        },
        "review_baseline_commit": {
          "$ref": "#/$defs/commit"
        },
        "plan_path": {
          "type": "string",
          "minLength": 1
        },
        "plan_section": {
          "type": "string",
          "minLength": 1
        },
        "boundary_path": {
          "type": "string",
          "minLength": 1
        },
        "boundary_section": {
          "type": "string",
          "minLength": 1
        },
        "contract_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CTR-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "external_fidelity_required": {
          "type": "boolean"
        },
        "prompt_path": {
          "type": "string",
          "minLength": 1
        },
        "findings_path": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "completed",
            "completed-with-limitations",
            "model-blocked",
            "scope-blocked",
            "failed",
            "verified",
            "fixed",
            "blocked"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_batch_id": {
          "type": "string",
          "pattern": "^RB-[0-9]{3,}$"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "reported_phase",
        "disposition",
        "assigned_phase",
        "status",
        "rationale",
        "fix_summary",
        "test_summary",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^RVW-PH-[0-9]{3,}-[0-9]{2,}-[0-9]{3,}$"
        },
        "reported_phase": {
          "$ref": "#/$defs/phaseId"
        },
        "disposition": {
          "enum": [
            "confirmed",
            "rejected",
            "duplicate",
            "already-fixed",
            "reassigned"
          ]
        },
        "assigned_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/phaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "pending",
            "fixed",
            "blocked",
            "not-applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "fix_summary": {
          "type": "string"
        },
        "test_summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported",
        "confirmed",
        "rejected",
        "duplicate",
        "already_fixed",
        "reassigned",
        "fixed",
        "blocked",
        "tests_added"
      ],
      "properties": {
        "reported": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "already_fixed": {
          "type": "integer",
          "minimum": 0
        },
        "reassigned": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "tests_added": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
